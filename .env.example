# Sanity — create a project at https://www.sanity.io/manage then paste IDs.
# Leave PROJECT_ID empty to use offline fixtures in lib/sanity/fallback.ts
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact (Resend) — POST /api/contact
# Create an API key at https://resend.com
# CONTACT_FROM_EMAIL must be a verified domain/sender in Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=pmluanvn@gmail.com
CONTACT_FROM_EMAIL=PML Resort <onboarding@resend.dev>

# Optional env fallbacks if not using Sanity siteSettings
